{
  "name": "SACCI Portal",
  "short_name": "SACCI",
  "description": "Sita Anandam Cancer Care Initiative — staff portal and public dashboard.",
  "id": "/portal.html",
  "start_url": "/portal.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FDFCFA",
  "theme_color": "#1a6b5a",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": [
            "application/zip",
            "application/x-zip-compressed",
            "application/octet-stream",
            "text/plain",
            "text/*",
            "image/*",
            ".zip",
            ".txt"
          ]
        }
      ]
    }
  }
}
